generate_block_graph <- function( n = 500, p_in = 0.3, p_out = 0.11 ) {
A <- matrix( 0, nrow = n, ncol = n )
block_size <- n / 2
for ( i in 1:( n - 1 ) ) {
for ( j in ( i + 1 ):n ) {
same_block <- ( i <= block_size && j <= block_size ) || ( i > block_size && j > block_size )
prob <- if ( same_block ) p_in else p_out
edge <- rbinom( 1, 1, prob )
A[ i, j ] <- edge
