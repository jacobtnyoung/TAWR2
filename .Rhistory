# setup
rm( list = ls() )
setwd( "/Users/jyoung20/GitHub/TAWR2" )
input_dir <- "data/XMLAuthorCorpus"
# use the dir function to make a vector of file names
files_v <- dir( path = input_dir, pattern = ".*xml" )
# load the xml2 library
library( xml2 )
# load the functions you need
source( "code/corpus_functions.R" )
# run the for loop to process each text
# create the object to add information to
book_freqs_l <- list()
for( i in seq_along( files_v ) ){
# set the xml object to read
xml_doc <- read_xml( file.path( input_dir, files_v[i] ) )
# create a string of all words in the paragraphs in the document
para_text <- get_node_text( xml_doc,
xpath = "/tei:TEI/tei:text/tei:body//tei:p",
ns = c( tei = "http://www.tei-c.org/ns/1.0" )
)
# tokenize the paragraphs
word_v <- tokenize( para_text )
# relative frequency of words
freq_table <- table( word_v ) / length( word_v )
# assign it to the book_freqs_l object
book_freqs_l[[files_v[i]]] <- as.data.frame(
freq_table, stringsAsFactors = FALSE
)
}
book_freqs_l
head(book_freqs_l)
freqs_df <- do.call( rbind, book_freqs_l )
head(freqs_df)
text_names_v <- gsub(
pattern =  "\\.\\d+",
replacement = "",
x = rownames( freqs_df )
)
text_names_v
head(freqs_df)
long_df <- data.frame( text_names_v, freqs_df )
head(long_df)
colnames( long_df ) <- c( "file", "token", "freq" )
head(long_df)
wide_t <- xtabs( formula = freq ~ file + token, data = long_df )
wide_t
head(wide_t)
wide_df <- as.data.frame( wide_t )
head(wide_df)
head(long_df)
token_means <- colMeans( wide_df )
wide_df <- as.data.frame.matrix( wide_t )
token_means <- colMeans( wide_df )
head( token_means )
keepers_v <- names( token_means[ which( token_means >= 0.01 ) ] )
dim(keepers_v)
length(keepers_v)
keepers_v
dist_m <- dist( wide_df[, keepers_v] )
dist_m
simple_dist_m <- as.matrix( dist_m )
simple_dist_m
sort( simple_dist_m[, "anonymous.xml"] )
cluster <- hclust( dist_m )
cluster$labels <- rownames( wide_df )
cluster
plot( cluster )
